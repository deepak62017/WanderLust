<% if(success && success.length) {%>
<div class="alert alert-success alert-warning alert-dismissible fade show clo-6 offset-6" role="alert">
  <%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if(error && error.length) {%>
<div class="alert alert-dang er alert-warning alert-dismissible fade show clo-6 offset-6" role="alert">
  <%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>