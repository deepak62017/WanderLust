<% layout("layouts/boilerplate")%>

    <div class="row">
        <div class="col-8 offset-2">
            <u>
                <h2>Edit your paste</h2>
            </u>

            <form method="post" action="/listings/<%=listings._id%>?_method=PUT" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="title" class="form-label">title</label>
                    <input name="listing[title]" value="<%=listings.title%>" type="text" class="form-control" required>
                    <div class="valid-feedback">look goods!</div>
                    <div class="invalid-feedback">title must be required</div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">description</label>
                    <textarea name="listing[description]" class="form-control"
                        required><%=listings.description%></textarea>
                    <div class="valid-feedback">look
                        goods!</div>
                    <div class="invalid-feedback">description must me required!</div>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">image</label>
                    <input name="listing[image]" value="<%=listings.image%> " type="string" type="text"
                        class="form-control" required>
                    <div class="valid-feedback">look
                        goods!</div>
                    <div class="invalid-feedback">image must be required!</div>

                </div>
                <div class="row ">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">price</label>
                        <input name="listing[price]" value="<%=listings.price%>" type="text" class="form-control"
                            required>
                        <div class="valid-feedback">look
                            goods!</div>
                        <div class="invalid-feedback">price must be required!</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">country</label>
                        <input name="listing[country]" value="<%=listings.country%>" type="text" class="form-control"
                            required>
                        <div class="valid-feedback">look
                            goods!</div>
                        <div class="invalid-feedback">counrty must be required</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">location</label>
                    <input name="listing[location]" value="<%=listings.location%>" type="text" class="form-control"
                        required>
                    <div class="valid-feedback">look
                        goods!</div>
                    <div class="invalid-feedback">laction must be required</div>
                </div>
                <button class="btn btn-dark edit-btn">submit</button>
            </form>
        </div>
    </div>
    <script src="/js/script.js"></script>