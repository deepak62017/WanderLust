<% layout("layouts/boilerplate") -%>
    <div class="row">
        <div class="col-8 offset-2">

            <h3>Creating new Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation ">
                <div>
                    <label for="title" class="form-label">title</label>
                    <input name="listing[title]" type="text" class="form-control" required>
                    <div class="valid-feedback">looks goods</div>
                </div>
                <br>
                <div>
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" required class="form-control" placeholder="hii this parish">
                </textarea>
                <div class="invalid-feedback">please enter valid description</div>

                </div>
                <br>
                <div>
                    <label for="image" class="form-label">Image Link</label>
                    <input name="listing[image]" type="text" placeholder="enter img/url" class="form-control">
                </div>

                <div class="row">
                    <div class=" mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" placeholder="4000" required type="text" class="form-control"
                            required>

                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">country</label>
                        <input name="listing[country]" placeholder="India" required type="text" class="form-control"
                            required>

                    </div>



                    <br>
                    <div>
                        <label for="location" class="form-label">location</label>
                        <input name="listing[location]" placeholder="Delhi" type="text" class="form-control" required>
                        <div class="invalid-feedbakc">please enter valid location</div>
                    </div>

                </div>
                <br>
                <button class="btn btn-dark">submit</button>
                <br>
                <br>
                <br>
            </form>
        </div>
    </div>