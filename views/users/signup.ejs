<% layout("/layouts/boilerplate") %>
  <div class="col-6 offset-3"> SIGNUP ON  WANDERLUST</div>
  <div class="row mt-2">
    <div class="col-6 offset-3">
      <form method="POST" action="/signup" class="needs-validation" novalidate>
        <div>
          <label for="username" class="form-label">username:</label>
          <input name="username" type="text" class="form-control" required>
          <div class="valid-feedback">looks goods</div>
        </div>
        <div class="mt-3">
          <label for="email" class="form-label">email:</label>
          <input name="email" type="email" class="form-control" required>
          <div class="valid-feedback">looks goods</div>
        </div>
        <div class="mt-3">
          <label for="password" class="form-label">password:</label>
          <input name="password" type="password" class="form-control" required>
          <div class="valid-feedback">looks goods</div>
        </div>
        <button class="btn  mt-3 btn-success">Signup</button>
      </form>
    </div>
  </div>